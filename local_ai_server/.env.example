# Ngrok Configuration
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# Model Configuration
MODEL_NAME=Qwen/Qwen3-0.6B
# Alternative models you can use:
# MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct
# MODEL_NAME=Gensyn/Qwen2.5-0.5B-Instruct
# MODEL_NAME=microsoft/DialoGPT-medium

# Model Storage Configuration
# Specify where to store/load models (default: ~/.cache/huggingface)
# Use this to organize models in a specific folder on your Ubuntu desktop
MODEL_CACHE_DIR=/home/$USER/ai-models
# Or use absolute path: MODEL_CACHE_DIR=/path/to/your/ai-models

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Hugging Face Token (optional, for gated models)
# Required for Pro subscription features and gated models
HF_TOKEN=your_huggingface_token_here

# Performance Optimization
# Use GPU if available (CUDA)
USE_GPU=true
# Load model in 8-bit mode for lower memory usage
LOAD_IN_8BIT=false
# Load model in 4-bit mode for even lower memory usage  
LOAD_IN_4BIT=false

# Generation Defaults (can be overridden per request)
DEFAULT_MAX_LENGTH=100
DEFAULT_TEMPERATURE=0.8
DEFAULT_TOP_P=0.9
